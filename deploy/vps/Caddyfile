# <domain>      the static landing page (deploy/vps/site)
# app.<domain>  the dashboard: Caddy serves the built SPA (/srv/app, pre-compressed .br/.zst/.gz);
#               only /api/* reaches the read-only replay
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}

{$SHIMPAKU_DOMAIN} {
	import common
	root * /srv/site
	file_server
}

app.{$SHIMPAKU_DOMAIN} {
	import common
	# MCP is never public: it is the agent write path. The replay app does not serve it either.
	respond /mcp* 404

	handle /api/* {
		reverse_proxy replay:8780
	}

	handle {
		root * /srv/app
		# Same policy the replay sets on the pages it serves (src/shimpaku/api/app.py).
		header {
			X-Frame-Options DENY
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		# Hashed bundles: cache forever; a missing one is a real 404, never the SPA shell.
		handle /assets/* {
			@exists file
			header @exists Cache-Control "public, max-age=31536000, immutable"
			file_server {
				precompressed br zstd gzip
			}
		}
		# Everything else is the shell or a client route: always revalidate.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server {
				precompressed br zstd gzip
			}
		}
	}
}
