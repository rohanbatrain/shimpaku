# Copy to ~/.config/shimpaku/env on the lab host (chmod 600). systemd reads it at start;
# it is never logged or committed. Everything else has a safe default (see CONTRACT.md).

# Lab device credentials (NETCONF + gNMI). Required — never defaulted in code.
SHIMPAKU_DEVICE_USER=admin
SHIMPAKU_DEVICE_PASSWORD=

# LLM gateway (LiteLLM). Optional: without it, "Ask Shim" reports that it is not configured.
SHIMPAKU_LLM_BASE=http://127.0.0.1:4000
SHIMPAKU_LLM_KEY=
SHIMPAKU_LLM_MODELS=triage=<cheap-model>,diagnose=<default-model>,escalate=<strong-model>

# Dashboard / MCP auth: off (loopback demo only) | local (admin password, scoped agent tokens)
SHIMPAKU_AUTH_MODE=off

# Used by ops/sync.sh and ops/demo/*.sh from a workstation
SHIMPAKU_LAB_HOST=
