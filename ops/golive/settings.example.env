# Copy to .local/settings.env (git-ignored) and fill in. Read by ops/golive/run.sh.
# ssh aliases (from ~/.ssh/config)
LAB_HOST="sitar"
VPS_HOST="kvm4"
VPS_ROOT="root@<vps public ip>"          # only for the one-time key install
VPS_PUBKEY="~/.ssh/bw-ssh.pub"           # public half of the key your agent serves
# NetBird addresses (netbird status on each host)
LAB_NETBIRD_IP="<lab netbird ip>"
VPS_NETBIRD_IP="<vps netbird ip>"
LAB_PORT="8780"
# public site
DOMAIN="<domain>"                        # landing at <domain>, dashboard at app.<domain>
REPO_URL="https://github.com/<you>/shimpaku"
PRIVACY_CONTACT="<email or LinkedIn URL>"
